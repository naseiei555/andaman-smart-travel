    "id": "events-url",
    "type": "function",
    "z": "andaman-flow",
    "name": "Forward public request",
    "func": "const base = env.get('ANDAMAN_API_URL') || 'http://backend:3001';\nmsg.method = 'GET';\nmsg.url = base + msg.req.originalUrl;\nmsg.headers = { accept: 'application/json' };\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
