  {
    "id": "admin-url",
    "type": "function",
    "z": "andaman-flow",
    "name": "Forward admin request and bearer token",
    "func": "const base = env.get('ANDAMAN_API_URL') || 'http://backend:3001';\nmsg.url = base + msg.req.originalUrl;\nmsg.method = msg.req.method;\nmsg.headers = { accept: 'application/json', 'content-type': 'application/json' };\nif (msg.req.headers.authorization) msg.headers.authorization = msg.req.headers.authorization;\nmsg.payload = msg.req.body;\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 390,
