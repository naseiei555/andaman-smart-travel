# Local development only. Use a unique, strong value outside local development.
POSTGRES_PASSWORD=andaman-local-only-change-me

POSTGRES_DB=andaman_db
POSTGRES_USER=andaman
POSTGRES_PORT=5432

FRONTEND_PORT=4200
BACKEND_PORT=3001
FRONTEND_ORIGIN=http://localhost:4200,http://127.0.0.1:4200,http://localhost:4300,http://127.0.0.1:4300
NODERED_PORT=1880

# Replace this local-development value with a new random secret before deployment.
# Use at least 32 random bytes and keep it only on trusted servers.
AUTH_JWT_SECRET=change-this-local-secret-to-a-random-value-at-least-32-characters
AUTH_JWT_ISSUER=
AUTH_JWT_AUDIENCE=

WEATHER_REQUEST_TIMEOUT_MS=8000
WEATHER_CACHE_TTL_MS=600000
